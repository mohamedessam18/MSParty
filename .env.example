# Copy to .env and fill in. Never commit real values to this file.

# Postgres. The sync server is one long-lived process, so give it the DIRECT
# Neon endpoint (no "-pooler" in the host). Vercel is serverless and wants the
# pooled one. Prisma migrations need the direct endpoint either way.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Web app only.
NEXTAUTH_URL="https://your-app.vercel.app"
# Generate with: openssl rand -hex 32
# Also signs the sync tokens, so it must match on the web app and sync server.
NEXTAUTH_SECRET=""

# Sync server only. The web app's origin, used for the socket's CORS check.
SYNC_SERVER_ORIGIN="https://your-app.vercel.app"

# The browser connects to this, so it must be NEXT_PUBLIC_ and set on Vercel.
# Inlined at build time — changing it needs a rebuild, not just a restart.
NEXT_PUBLIC_SYNC_SERVER_URL="https://your-sync-server.up.railway.app"

# Cloudflare R2. Needed by the web app for uploads, and by the sync server for
# the cleanup job. Without them cleanup silently does nothing.
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="msparty-videos"
R2_PUBLIC_URL="https://PUBLIC_BUCKET_ID.r2.dev"

# YouTube Data API v3 key, for the title, channel, description and duration of
# a pasted link. Create one at console.cloud.google.com -> APIs & Services ->
# Credentials, with the YouTube Data API v3 enabled. Server-side only, so it
# must NOT be NEXT_PUBLIC_. Without it a party still works: the thumbnail comes
# straight off YouTube's CDN, and the rest of the details are simply blank.
YOUTUBE_API_KEY=""

# Web Push. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key ships to the browser, so it must be NEXT_PUBLIC_ and set at
# build time on Vercel. Without both, device notifications quietly do nothing.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT="mailto:you@example.com"

# Authorises the daily cleanup cron. Vercel sends it as a Bearer token.
# Generate with: openssl rand -hex 32
CRON_SECRET=""
