# Copy to .env and fill in. Never commit real values to this file.

# Postgres. The sync server is one long-lived process, so give it the DIRECT
# Neon endpoint (no "-pooler" in the host). Vercel is serverless and wants the
# pooled one. Prisma migrations need the direct endpoint either way.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Web app only.
# The origin this app calls itself, and the one every link in an outgoing email
# is built on. Set it to your *custom* domain, not the vercel.app one: a message
# sent from no-reply@your-domain.com whose links all point at a vercel.app
# subdomain is the exact shape of a phishing mail, and Gmail scores it that way.
NEXTAUTH_URL="https://your-app.vercel.app"
# Generate with: openssl rand -hex 32
# Also signs the sync tokens, so it must match on the web app and sync server.
NEXTAUTH_SECRET=""

# Google sign-in. Create an OAuth 2.0 Client ID at console.cloud.google.com ->
# APIs & Services -> Credentials, type "Web application", and add these two:
#   Authorised JavaScript origin:  https://your-app.vercel.app
#   Authorised redirect URI:       https://your-app.vercel.app/api/auth/callback/google
# For local work add http://localhost:3000 and .../api/auth/callback/google too.
# Leave both blank and the Google button simply does not appear — everything
# else works unchanged.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Outgoing mail, via Resend (resend.com). Optional: with these blank nothing is
# ever sent and no flow is blocked — registration, deletion and restore all work
# without a mail provider. Set them to turn on the confirmation link, the
# "your account is scheduled for deletion" notice, and the reminder that goes
# out three days before erasure.
# MAIL_FROM must be an address on a domain verified with the provider.
RESEND_API_KEY=""
MAIL_FROM="MSParty <no-reply@your-domain.com>"
# Optional, and worth setting: a From address whose replies go nowhere is one of
# the things spam filters count against a sender.
MAIL_REPLY_TO=""

# Deliverability, once mail works at all: the address in MAIL_FROM and the links
# inside the message should be on the same domain. A message from your-domain.com
# whose every link points at a vercel.app subdomain has the exact shape of a
# phishing attempt, and Gmail scores it that way — so point a subdomain at the
# deployment and set NEXTAUTH_URL to it. Add a DMARC record too:
#   TXT  _dmarc  ->  v=DMARC1; p=none; rua=mailto:you@your-domain.com

# Sync server only. The web app's origin, used for the socket's CORS check.
SYNC_SERVER_ORIGIN="https://your-app.vercel.app"

# The browser connects to this, so it must be NEXT_PUBLIC_ and set on Vercel.
# Inlined at build time — changing it needs a rebuild, not just a restart.
NEXT_PUBLIC_SYNC_SERVER_URL="https://your-sync-server.up.railway.app"

# Cloudflare R2. Needed by the web app for uploads, and by the sync server for
# the cleanup job. Without them cleanup silently does nothing.
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="msparty-videos"
R2_PUBLIC_URL="https://PUBLIC_BUCKET_ID.r2.dev"

# YouTube Data API v3 key, for the title, channel, description and duration of
# a pasted link. Create one at console.cloud.google.com -> APIs & Services ->
# Credentials, with the YouTube Data API v3 enabled. Server-side only, so it
# must NOT be NEXT_PUBLIC_. Without it a party still works: the thumbnail comes
# straight off YouTube's CDN, and the rest of the details are simply blank.
YOUTUBE_API_KEY=""

# Web Push. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key ships to the browser, so it must be NEXT_PUBLIC_ and set at
# build time on Vercel. Without both, device notifications quietly do nothing.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT="mailto:you@example.com"

# Authorises the daily cleanup cron. Vercel sends it as a Bearer token.
# Generate with: openssl rand -hex 32
CRON_SECRET=""
