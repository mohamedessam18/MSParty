generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  // Null for guests, who join with a name only and can claim an email later.
  // Postgres permits many NULLs under a unique index, so this stays unique.
  email String? @unique
  // When the address was proven to be theirs — by a Google sign-in, which only
  // ever hands over a verified address, or by following a link we mailed. Null
  // means unproven, not unusable: nothing is gated on it yet.
  emailVerified DateTime?
  passwordHash String?
  isGuest Boolean @default(false)
  // How people find each other. Null until chosen, and never set for guests —
  // a guest session cannot be signed back into, so being findable is pointless.
  username String? @unique
  // The impersonation-proof form of the name: dots and underscores stripped and
  // look-alike characters folded. Unique, so the database — not a racy
  // check-then-insert — is what stops two people claiming the same shape.
  usernameCanonical String? @unique
  usernameChangedAt DateTime?
  // Bumped to end every session that exists. A JWT cannot be recalled once it
  // is issued, so the only way to make "sign out everywhere" mean anything is
  // to record a number the token has to still match — see lib/auth.ts.
  tokenVersion Int @default(0)
  // Appear offline to friends without leaving the network.
  invisible Boolean @default(false)
  // When erasure was asked for. The account is hidden from that moment and
  // erased once the grace period is up; signing in before then is refused and
  // offers to bring it back instead.
  deletionRequestedAt DateTime?
  // What `invisible` was before we forced it on. Restoring has to put back the
  // choice they made themselves, and "false" is not a safe guess: someone who
  // was deliberately invisible would come back visible without being asked.
  invisibleBeforeDeletion Boolean?
  // Stops the "your account is erased in three days" mail going out nightly for
  // the rest of the grace period.
  deletionReminderSentAt DateTime?
  name String
  avatarUrl String?
  createdAt DateTime @default(now())
  accounts Account[]
  tvDevices TvDevice[]
  verificationTokens VerificationToken[]
  hostedParties Party[] @relation("HostedParties")
  memberships PartyMember[]
  messages ChatMessage[]
  uploads UploadedVideo[]
  queueItems QueueItem[]
  queueVotes QueueVote[]
  sentRequests Friendship[] @relation("FriendRequester")
  receivedRequests Friendship[] @relation("FriendAddressee")
  notifications Notification[] @relation("NotificationOwner")
  actedNotifications Notification[] @relation("NotificationActor")
  invitesReceived PartyInvite[] @relation("InviteTo")
  invitesSent PartyInvite[] @relation("InviteFrom")
  blocksMade Block[] @relation("Blocker")
  blocksAgainst Block[] @relation("Blocked")
  pushSubscriptions PushSubscription[]
  usernameHolds UsernameHold[]
  watchHistory WatchHistory[]
}

// A sign-in method that is not a password: one row per provider identity, so an
// account reached with Google today can gain a password tomorrow without either
// one displacing the other. Shaped like NextAuth's own table on purpose — the
// linking is done in lib/auth.ts rather than by an adapter, because an adapter
// would create accounts without a username and every screen here assumes one.
model Account {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // oauth | oidc
  type String
  // google
  provider String
  // The provider's own immutable id for the person — "sub" for Google. Never
  // the email: an address can be reassigned by a workspace admin, a sub cannot.
  providerAccountId String
  refresh_token String?
  access_token String?
  expires_at Int?
  token_type String?
  scope String?
  id_token String?
  session_state String?
  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// A television that has been handed an account, once.
//
// A TV browser is driven by a four-way remote, so signing in on it means typing
// an address and a password with an on-screen keyboard — the single worst input
// method in the house. Instead the set shows a code, a phone that is already
// signed in claims it, and the set keeps the resulting credential.
//
// The row is the credential: whoever holds `secret` can ask for a sync token
// for `user` at any time, which is why it is stored hashed, scoped to one
// party, and revocable from the phone that created it.
model TvDevice {
  id String @id @default(cuid())
  // Shown on the television, read out loud, typed into a phone. Same alphabet
  // as a party code — no characters that are confused at six feet.
  code String @unique
  // sha256 of the secret the set was handed. Never stored in the clear.
  secretHash String @unique
  // Null until a phone claims it. Both are set together.
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  partyId String?
  party Party? @relation(fields: [partyId], references: [id], onDelete: SetNull)
  // What the set calls itself, for the "your televisions" list on the phone.
  label String?
  claimedAt DateTime?
  lastSeenAt DateTime?
  // Minutes while it is an unclaimed code on a screen, months once it is a
  // television someone owns.
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// A one-time link mailed to an address to prove it belongs to whoever asked.
// The token is stored hashed: a leaked database should not hand out live links.
model VerificationToken {
  id String @id @default(cuid())
  // What is being proven — the email address, lowercased.
  // What is being proven. The address for verify_email and reset_password, and
  // the *new* address for change_email — which is why userId exists: at that
  // point the address does not identify anyone yet.
  identifier String
  tokenHash String @unique
  // verify_email | reset_password | change_email
  purpose String @default("verify_email")
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([identifier, purpose])
  @@index([expiresAt])
}

// Attempt counters for sign-in, registration and guest creation.
//
// In a table rather than in memory because the web app runs as serverless
// functions: each request may land in a fresh instance, so an in-process
// counter would reset itself often enough to be no limit at all.
model RateLimit {
  // What is being limited, e.g. "login:ip:203.0.113.4" or "login:email:a@b.c".
  key String @id
  count Int @default(1)
  // When the current window ends. Rows are dropped after this by the nightly
  // job; a row that is merely stale is treated as empty on the next attempt.
  expiresAt DateTime

  @@index([expiresAt])
}

// What someone has watched, kept as a snapshot rather than a pointer: a party
// is a room that gets torn down, but "the film we saw last Thursday" should
// still be findable — and startable again — after the room is gone.
model WatchHistory {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nulled when the party is deleted, which is why every field below is copied
  // instead of read through the relation.
  partyId String?
  party Party? @relation(fields: [partyId], references: [id], onDelete: SetNull)
  partyName String
  hostName String?
  contentType String
  contentUrl String?
  title String
  posterUrl String?
  channel String?
  durationSeconds Float?
  // Where they stopped, so the row can offer to pick up rather than restart.
  positionSeconds Float @default(0)
  watchedAt DateTime @default(now())

  // One row per party per person: revisiting a room updates its entry rather
  // than stacking a second one. Postgres allows many NULLs here, so rows whose
  // party has since been deleted no longer collide with each other.
  @@unique([userId, partyId])
  @@index([userId, watchedAt])
  @@index([watchedAt])
}

// A released name is parked rather than freed, so nobody can pick up an
// identity the moment its owner steps away from it.
model UsernameHold {
  id String @id @default(cuid())
  username String @unique
  canonical String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  heldUntil DateTime
  createdAt DateTime @default(now())

  @@index([heldUntil])
}

// One row per browser, not per person: someone with a phone and a laptop wants
// the notice on whichever they are holding.
model PushSubscription {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh String
  auth String
  userAgent String?
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// Blocking has to exist the moment strangers can send requests: without it the
// only remedy for harassment is deleting the account.
model Block {
  id String @id @default(cuid())
  blockerId String
  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// An invitation to a specific person, which is the only way into a private
// party. Kept after it is answered so a declined invite is not silently resent.
model PartyInvite {
  id String @id @default(cuid())
  partyId String
  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  invitedId String
  invited User @relation("InviteTo", fields: [invitedId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy User @relation("InviteFrom", fields: [invitedById], references: [id], onDelete: Cascade)
  // pending | accepted | declined
  status String @default("pending")
  createdAt DateTime @default(now())

  @@unique([partyId, invitedId])
  @@index([invitedId, status])
}

// Persisted so an invite sent while someone is offline is still waiting when
// they return; live delivery over the socket is an optimisation on top.
model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation("NotificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  // friend_request | friend_accepted | party_invite | friend_live
  type String
  actorId String?
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  partyId String?
  body String?
  readAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// One row per pair, holding both the pending request and the settled
// friendship. Storing it once rather than twice keeps the two directions from
// ever disagreeing about whether a friendship exists.
model Friendship {
  id String @id @default(cuid())
  requesterId String
  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  // pending | accepted
  status String @default("pending")
  createdAt DateTime @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}
model Party {
  id String @id @default(cuid())
  code String @unique
  hostId String
  host User @relation("HostedParties", fields: [hostId], references: [id])
  tvDevices TvDevice[]
  name String
  // youtube | upload | platform. A platform party is watched on the service's
  // own site through the extension; contentUrl holds the deep link to it.
  contentType String
  contentUrl String?
  // Which service, when contentType is "platform". Kept as its own column so a
  // party can be found by service without parsing every URL.
  platform String?
  currentTimestamp Float @default(0)
  isPlaying Boolean @default(false)
  isLocked Boolean @default(false)
  // private  — invited people only
  // friends  — any friend of the host, no code needed
  // code     — anyone holding the code or link
  visibility String @default("code")
  // Shared so everyone reads the same cues at the same speed.
  subtitlesUrl String?
  playbackRate Float @default(1)
  // What is actually playing, as opposed to what the host called the room.
  // Resolved once when the party is made — from the file for an upload, from
  // YouTube for a link — so every later reader is free.
  posterUrl String?
  videoTitle String?
  videoChannel String?
  videoDescription String?
  videoDuration Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members PartyMember[]
  messages ChatMessage[]
  queue QueueItem[]
  invites PartyInvite[]
  uploadedVideo UploadedVideo?
  history WatchHistory[]
}
model QueueItem {
  id String @id @default(cuid())
  partyId String
  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  addedById String
  addedBy User @relation(fields: [addedById], references: [id], onDelete: Cascade)
  title String
  contentType String
  contentUrl String
  position Int
  createdAt DateTime @default(now())
  votes QueueVote[]

  @@index([partyId, position])
}
model QueueVote {
  id String @id @default(cuid())
  queueItemId String
  queueItem QueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([queueItemId, userId])
}
model PartyMember {
  id String @id @default(cuid())
  partyId String
  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role String @default("viewer")
  joinedAt DateTime @default(now())
  @@unique([partyId, userId])
}
model UploadedVideo {
  id String @id @default(cuid())
  uploaderId String
  uploader User @relation(fields: [uploaderId], references: [id])
  partyId String? @unique
  party Party? @relation(fields: [partyId], references: [id], onDelete: SetNull)
  fileUrl String
  storageKey String @unique
  title String?
  duration Float?
  // A frame lifted from the file in the browser before upload. Optional: some
  // codecs never fire a seek, and a library row reads fine without it.
  posterUrl String?
  // Float, not Int: the 2GB ceiling is one byte past Int32's range.
  sizeBytes Float?
  // "pending" until the bytes are confirmed uploaded, then "ready". Only ready
  // rows appear in a user's library; pending ones carry a cleanupAt so an
  // abandoned upload cannot linger.
  status String @default("pending")
  // S3 multipart upload id, kept so an interrupted upload can be resumed or aborted.
  multipartId String?
  uploadedAt DateTime @default(now())
  cleanupAt DateTime?

  @@index([cleanupAt])
  @@index([uploaderId, status])
}
model ChatMessage {
  id String @id @default(cuid())
  partyId String
  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  // Null once the author erases their account. The row stays so the rest of the
  // conversation still reads in order, but nothing in it points at a person any
  // more, and the text itself is blanked at the same time.
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  message String
  sentAt DateTime @default(now())

  @@index([partyId, sentAt])
}
