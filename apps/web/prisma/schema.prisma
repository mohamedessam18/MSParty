generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  // Null for guests, who join with a name only and can claim an email later.
  // Postgres permits many NULLs under a unique index, so this stays unique.
  email String? @unique
  passwordHash String?
  isGuest Boolean @default(false)
  name String
  avatarUrl String?
  createdAt DateTime @default(now())
  hostedParties Party[] @relation("HostedParties")
  memberships PartyMember[]
  messages ChatMessage[]
  uploads UploadedVideo[]
  queueItems QueueItem[]
  queueVotes QueueVote[]
}
model Party {
  id String @id @default(cuid())
  code String @unique
  hostId String
  host User @relation("HostedParties", fields: [hostId], references: [id])
  name String
  contentType String
  contentUrl String?
  currentTimestamp Float @default(0)
  isPlaying Boolean @default(false)
  isLocked Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members PartyMember[]
  messages ChatMessage[]
  queue QueueItem[]
  uploadedVideo UploadedVideo?
}
model QueueItem {
  id String @id @default(cuid())
  partyId String
  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  addedById String
  addedBy User @relation(fields: [addedById], references: [id], onDelete: Cascade)
  title String
  contentType String
  contentUrl String
  position Int
  createdAt DateTime @default(now())
  votes QueueVote[]

  @@index([partyId, position])
}
model QueueVote {
  id String @id @default(cuid())
  queueItemId String
  queueItem QueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([queueItemId, userId])
}
model PartyMember {
  id String @id @default(cuid())
  partyId String
  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role String @default("viewer")
  joinedAt DateTime @default(now())
  @@unique([partyId, userId])
}
model UploadedVideo {
  id String @id @default(cuid())
  uploaderId String
  uploader User @relation(fields: [uploaderId], references: [id])
  partyId String? @unique
  party Party? @relation(fields: [partyId], references: [id], onDelete: SetNull)
  fileUrl String
  storageKey String @unique
  duration Float?
  uploadedAt DateTime @default(now())
  cleanupAt DateTime?

  @@index([cleanupAt])
}
model ChatMessage {
  id String @id @default(cuid())
  partyId String
  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id])
  message String
  sentAt DateTime @default(now())
}
